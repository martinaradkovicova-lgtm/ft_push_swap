@startuml

legend
    |= Stack |= Disorder|= Order       |= Operations        |
    | A | 0.000000      | 1 < 2 < 3 | - ascending sorted |
    | B | 1.000000      | 3 > 2 > 1 | (sa, rra) or (ra, sa)   |
    | C | 0.333333      | 1 < 3 > 2 | (rra, sa) or (sa, ra)   |
    | D | 0.666667      | 2 < 3 > 1 | rra                | |
    | E | 0.333333      | 2 > 1 < 3 | sa                 |
    | F | 0.666667      | 3 > 1 < 2 | ra                 |
endlegend

stack A {
node "1" as a1 #pink
node "2" as a2 #Violet
node "3" as a3 #salmon
a1 <--> a2
a2 <--> a3
}

stack B {
node "3" as b1 #salmon
node "2" as b2 #Violet
node "1" as b3 #pink
b1 <--> b2
b2 <--> b3
}

stack C {
node "1" as c1 #pink
node "3" as c2 #salmon
node "2" as c3 #Violet
c1 <--> c2
c2 <--> c3
}

stack D {
node "2" as d1 #Violet
node "3" as d2 #salmon
node "1" as d3 #pink
d1 <--> d2
d2 <--> d3
}

stack E {
node "2" as e1 #Violet
node "1" as e2 #pink
node "3" as e3 #salmon
e1 <--> e2
e2 <--> e3
}

stack F {
node "3" as f1 #salmon
node "1" as f2 #pink
node "2" as f3 #Violet
f1 <--> f2
f2 <--> f3
}