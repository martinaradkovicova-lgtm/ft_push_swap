@startuml

skinparam {
StackBorderThickness 2
NodeBorderThickness 1
NodeFontSize 16
    legend {
        FontSize 20
        BackgroundColor SnowWhite
    }
    title {
    FontSize 30
    }
}
title Possible permutations of four numbers (4!) (3/4) 
legend
    |= Stack |= Disorder|= Order       |= Operations        |
    | A | 0.333333      | (a > b) (b < c) (c < d) (b < d) |(sa) (pb) (sa) (pa) |
    | B | 0.500000      | (a > b) (b < c) (c > d) (b < d) | (sa) (pb) (rra) (ba) |
    | C | 0.500000      | (a > b) (b > c) (c < d) (b < d) | (rra)(rra)(pb)(ra)(sa)(pa)  |
    | D | 0.666667      | (a > b) (b < c) (c > d) (b > d)| (rra) (pb) (sa) (pa)| |
    | E | 0.666667      | (a < b) (b > c) (c < d) (b > d) | (rra) (rra)            |
    | F | 0.833333      | (a < b) (b > c) (c > d) (b > d) | (rra) (pb) (rra) (pa)|
endlegend

stack stack_a {
node null as n1_null #white
node a as a #white
node b as b #white
node c as c #white
node d as d #white
node null as n3_null #white
n1_null <-- a : prev
a <-- b : prev
a --> b : next
b <-- c : prev
b --> c : next
c --> d : next
c <-- d : prev
d --> n3_null : next
}


stack A {
node null as a1_null #white
node "1" as a2 #Gold
node "2" as a3 #Magenta
node "3" as a1 #turquoise
node "4" as a4 #Yellow
node null as a3_null #white
a1_null <-- a1
a1 <-- a2 
a1 --> a2
a2 <-- a3
a2 --> a3
a3 <-- a4
a3 --> a4
a4 --> a3_null
}

