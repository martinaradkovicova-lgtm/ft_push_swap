@startuml
start
skinparam {
ActivityBackgroundColor LightGreen;
ActivityDiamondBackgroundColor yellow;
ActivityFontSize 16;
ActivityBorderThickness 2
title {
FontSize 32
}
}
title "Algorithm for sorting five numbers"
partition "int five_minimum_index(t_stack *stack_a)" {
    :a = stack_a->top->value;
    :b = stack_a->top->next->value;
    :c = stack_a->top->next->next->value;
    :d = stack_a->bottom->prev->value;
    :e = stack_a->bottom->value;
    
    if ((a < b) && (a < c) && (a < d) && (a < e)) is (true) then
        :return (0);
    else if ((b < a) && (b < c) && (b < d) && (b < e)) is (true) then
        :return (1);
    else if ((c < a) && (c < b) && (c < d) && (c < e)) is (true) then
        :return (2);
    else if ((d < a) && (d < b) && (d < c) && (d < e)) is (true) then
        :return (3);
    else
        :return (4);
    endif
    stop
}


partition "sort_five(t_stack *stack_a, t_stack *stack_b) {
if (stack_a == NULL || stack_b == NULL || stack_a->top == NULL)
    :return ; <<#salmon>>
    stop
endif

:minimum_idx = five_minimum_index(stack_a);
if (minimum_idx == 1) is (true) then
    :sa(stack_a);
else if (minimum_idx == 2) is (true) then
    :ra(stack_a);
    :ra(stack_a);
else if(minimum_idx == 3) is (true) then
    :rra(stack_a);
    :rra(stack_a);
else if (minimum_idx == 4) is (true) then
    :rra(stack_a);
endif
if (compute_disorder > 0.000000) is (true) then
:pb(stack_a, stack_b);
:sort_four(stack_a);
:pa(stack_b, stack_a);
endif

stop
@enduml