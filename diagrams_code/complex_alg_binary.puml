@startuml

skinparam {
    StackBorderThickness 2
    NodeBorderThickness 1
    NodeFontSize 13
    legend {
        FontSize 12
        BackgroundColor SnowWhite
    }
    title {
        FontSize 32
    }
}

title "Complex algorithm - Radix sort binary operations"

legend
    |= Step     |= Bit Checked  |= Operation    |= Stack A (top -> bottom) |= Stack B (top -> bottom) |
    | 1. Start | Initial | - | 2 (10), 1 (01), 0 (00), 3 (11) | empty |
    | 2. Bit 0 Split | Bit 0 (LSB) | pb 0s (2, 0), ra 1s (1, 3) | **1 (01), 3 (11)** | **0 (00), 2 (10)** |
    | 3. Bit 0 End | Bit 0 (LSB) | pa 0, pa 2 | **2 (10), 0 (00), 1 (01), 3 (11)** | empty |
    | 4. Bit 1 Split | Bit 1 (MSB) | pb 0s (0, 1), ra 1s (2, 3) | **2 (10), 3 (11)** | **1 (01), 0 (00)** |
    | 5. Final State| Bit 1 (MSB) | pa 1, pa 0 | **0 (00), 1 (01), 2 (10), 3 (11)** | empty |
endlegend

' === 1. INITIAL STATE ===
stack "1. Start\nstack_a" as s1_a {
    node null as s1a_n1 #white
    node "index 2 (10)" as s1a_2 #Cyan
    node "index 1 (01)" as s1a_1 #Gold
    node "index 0 (00)" as s1a_0 #Magenta
    node "index 3 (11)" as s1a_3 #Yellow
    node null as s1a_n2 #white
    s1a_n1 <-- s1a_2 : prev
    s1a_2 <-- s1a_1 : prev
    s1a_2 --> s1a_1 : next
    s1a_1 <-- s1a_0 : prev
    s1a_1 --> s1a_0 : next
    s1a_0 <-- s1a_3 : prev
    s1a_0 --> s1a_3 : next
    s1a_3 --> s1a_n2 :next
}

' === 2. BIT 0: SPLIT TO B ===
stack "2. Bit 0 Split\nstack_a" as s2_a {
    node null as s2a_n1 #white
    node "1 (01)" as s2a_1 #Gold
    node "3 (11)" as s2a_3 #Yellow
    node null as s2a_n2 #white
    s2a_n1 <-- s2a_1 : prev
    s2a_1 <-- s2a_3 : prev
    s2a_1 --> s2a_3 : next
    s2a_3 --> s2a_n2 : next
}

stack "2. Bit 0 Split\nstack_b" as s2_b {
    node null as s2b_n1 #white
    node "0 (00)" as s2b_0 #Magenta
    node "2 (10)" as s2b_2 #Cyan
    node null as s2b_n2 #white
    s2b_n1 <-- s2b_0 :prev
    s2b_0 <-- s2b_2 : prev
    s2b_0 --> s2b_2 : next
    s2b_2 --> s2b_n2 : next
}

' === 3. BIT 0: AFTER PA ===
stack "3. Bit 0 End\nstack_a" as s3_a {
    node null as s3a_n1 #white
    node "2 (10)" as s3a_2 #Cyan
    node "0 (00)" as s3a_0 #Magenta
    node "1 (01)" as s3a_1 #Gold
    node "3 (11)" as s3a_3 #Yellow
    node null as s3a_n2 #white
    s3a_n1 <-- s3a_2 : prev
    s3a_2 <-- s3a_0 : prev
    s3a_2 --> s3a_0 : next
    s3a_0 <-- s3a_1 : prev
    s3a_0 --> s3a_1 : next
    s3a_1 <-- s3a_3 : prev
    s3a_1 --> s3a_3 : next
    s3a_3 --> s3a_n2 : next
}

' === 4. BIT 1: SPLIT TO B (0s go to B: 0 and 1) ===
stack "4. Bit 1 Split\nstack_a" as s4_a {
    node null as s4_a_n1 #white
    node "2_(10)" as s4_a_2 #Cyan
    node "3_(11)" as s4_a_3 #Yellow
    node null as s4_a_n2 #white
    s4_a_n1 <-- s4_a_2 : prev
    s4_a_2 <-- s4_a_3 : prev
    s4_a_2 --> s4_a_3 : next
    s4_a_3 --> s4_a_n2 : next
}

stack "4. Bit 1 Split\nstack_b" as s4_b {
    node null as s4_b_n1 #white
    node "1 (01)" as s4_b_1 #Gold
    node "0 (00)" as s4_b_0 #Magenta
    node null as s4_b_n2 #white
    s4_b_n1 <-- s4_b_1 : prev
    s4_b_1 <-- s4_b_0 : prev
    s4_b_1 --> s4_b_0 : next
    s4_b_0 --> s4_b_n2 : next
}

stack "5. SORTED!\nstack_a" as s5_a {
    node null as s5a_n1 #white
    node "0 (00)" as s5a_0 #Magenta
    node "1 (01)" as s5a_1 #Gold
    node "2 (10)" as s5a_2 #Cyan
    node "3 (11)" as s5a_3 #Yellow
    node null as s5a_n2 #white
    s5a_n1 <-- s5a_0 : prev
    s5a_0 <-- s5a_1 : prev
    s5a_0 --> s5a_1 : next
    s5a_1 <-- s5a_2 : prev
    s5a_1 --> s5a_2 : next
    s5a_2 <-- s5a_3 : prev
    s5a_2 --> s5a_3 : next
    s5a_3 --> s5a_n2 : next
}

@enduml
